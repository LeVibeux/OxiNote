---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../data/features";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  altPath: string;
}

const { lang, title, description, path, altPath } = Astro.props;
const fr = lang === "fr" ? path : altPath;
const en = lang === "en" ? path : altPath;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/media/icon.png" type="image/png" />
    <link rel="alternate" hreflang="fr" href={fr} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={fr} />
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <a class="skip" href="#contenu">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>
    <Header lang={lang} path={path} altPath={altPath} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline src="/scripts/site.js" defer></script>
  </body>
</html>
