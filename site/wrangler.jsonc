{
  // Site statique privé. Ne pas déployer tant que le propriétaire n'a pas
  // validé le contenu et suivi site/DEPLOY.md (Cloudflare Access).
  // Documentation : https://developers.cloudflare.com/workers/static-assets/
  "name": "oxinote-prive",
  "compatibility_date": "2026-11-13",
  // Pas de domaine personnalisé : uniquement le sous-domaine workers.dev,
  // à protéger avec Access avant toute diffusion de l'URL.
  "workers_dev": true,
  // Les URL de version / preview (<version>-<nom>.<compte>.workers.dev)
  // suivent workers.dev si ce champ est omis. On les coupe explicitement.
  // https://developers.cloudflare.com/workers/versions-and-deployments/version-urls/
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Pas de journaux Worker pour l'éditeur. Les journaux de plateforme
  // Cloudflare, eux, ne se coupent pas depuis ce fichier.
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    }
  }
}
