# https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; script-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), interest-cohort=()
